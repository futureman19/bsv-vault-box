      "independent_visual": {
        "assessment": {
          "defects": [],
          "id": "latvia",
          "limitations": [
            "Linen reads as a rigid insert and weave is unresolved at mobile scale.",
            "Amber is opaque and stylized; promotional versus runtime hue/gloss differs without indicating malfunction.",
            "Dark closed seam reads raised; documented design concern rather than demonstrated bad closure.",
            "Front-open view hides lid ornament and small contact details."
          ],
          "observations": [
            {
              "image": "parent/sources/latvia/marketing.webp",
              "observation": "Light wood and dark finger joints frame a smooth ivory panel with burgundy stripes and three peach-orange domes on square brass settings. Stone-like feet and gold fittings; polished presentation."
            },
            {
              "image": "parent/smoke/latvia/desktop-closed.png",
              "observation": "Cream/carmine panel and three honey-yellow domes read clearly. Weave is not convincingly resolved and domes are more opaque/yellow than promotional peach gloss. Pronounced dark closed seam; full silhouette visible."
            },
            {
              "image": "parent/smoke/latvia/desktop-open.png",
              "observation": "Plain warm wood lid underside and empty cavity, rear hinge fittings, front hardware and raised tab are visible. Ornaments face away naturally. All parts fit without cropping."
            },
            {
              "image": "parent/smoke/latvia/mobile-closed.png",
              "observation": "Three ornaments and cream/red panel remain distinguishable. Seam stays dark and conspicuous; fine textile detail disappears. Model, title and both controls fit without overlap."
            },
            {
              "image": "parent/smoke/latvia/mobile-open.png",
              "observation": "Open cavity and two rear fittings remain legible, floor partly obscured. Small fittings have coarse edges; no obvious detached part or UI clipping."
            }
          ],
          "rationale": "Core panel/three-cabochon motif survives both viewport sizes and all poses are fully framed; limitations are disclosed and no unmistakable visual failure is shown.",
          "readme_context": "Invented cream/carmine linen-inspired motif, three deliberately opaque amber cabochons; weave resolution, rigid insert appearance and conspicuous seam disclosed. No original reference artwork existed during authoring.",
          "recommendation": "candidate-with-limitations",
          "source_readme": "parent/sources/latvia/source_readme.md"
        },
        "report": "visual-c.json"
      },

      "independent_visual": {
        "assessment": {
          "defects": [],
          "id": "japan",
          "limitations": [
            "Promotional dense foliage/plush moss is not reproduced photorealistically; documented stylization rather than functional failure.",
            "Green seam can make closed lid look slightly raised; no closure failure established.",
            "Fine foliage aliases and mobile moss/hinge details are small; lower interior and rear contacts are partly occluded."
          ],
          "observations": [
            {
              "image": "parent/sources/japan/marketing.webp",
              "observation": "Labeled promotional illustration: dense, organically clustered miniature tree and plush moss on granite; warm grained wood, brass hardware, green seam and stone feet. More realistic surface treatment than runtime."
            },
            {
              "image": "parent/smoke/japan/desktop-closed.png",
              "observation": "Wood/joinery, brass, moss-rock base and conifer remain identifiable. Runtime tree is smaller/airier and stippled, wood brighter orange and hardware flatter than marketing. Broad green lid reveal is conspicuous. Whole silhouette fits."
            },
            {
              "image": "parent/smoke/japan/desktop-open.png",
              "observation": "Empty wood-toned cavity, green rim, two rear hinge fittings and raised latch tab are visible. Exterior tree turns away. Entire lid/tab/feet fit; no unequivocal missing geometry or detached component."
            },
            {
              "image": "parent/smoke/japan/mobile-closed.png",
              "observation": "Chest and buttons remain fully framed; tree silhouette is recognizable but fine foliage and moss are weak at native scale. Orange wood dominates the nature motif. No visible layout overlap."
            },
            {
              "image": "parent/smoke/japan/mobile-open.png",
              "observation": "Open cavity and brass fittings remain readable at overview scale, with lower floor partly hidden by front wall. Raised lid and feet fit; small hinge contacts cannot be judged precisely."
            }
          ],
          "rationale": "Coherent theme and intact closed/open framing on both sizes; observed weaknesses align with documented limits, with no confirmed visual blocker.",
          "readme_context": "Cedar v2 explicitly documents a stylized, airy miniature conifer, planar/stippled branch tiers and mobile moss detail limits after one bounded visual correction.",
          "recommendation": "candidate-with-limitations",
          "source_readme": "parent/sources/japan/source_readme.md"
        },
        "report": "visual-c.json"
      },

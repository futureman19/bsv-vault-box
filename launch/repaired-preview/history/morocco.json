            ],
            "file": "sources/morocco/marketing.webp",
            "observations": "Predominantly ivory/cream/honey horizontally banded polished stone body, chocolate lid, smooth gray-brown center, intricate green-white floral/geometric perimeter inlay with fine edging, small peach mountain ornament. Brass central clasp, round medallion, low front ring and bottom guards."
          },
          "retained_status": "partial unapproved"
        }

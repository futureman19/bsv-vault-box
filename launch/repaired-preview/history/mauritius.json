      "independent_visual": {
        "assessment": {
          "defects": [],
          "id": "mauritius",
          "limitations": [
            "Seven separate mineral ribbons are not confidently countable from supplied default views; source claim is not independently verified by these stills.",
            "Marketing has finer wood/material finish and clearer pastel separation; runtime is a stylized clay-like interpretation.",
            "Dark seam and long clasp are visually prominent but disclosed; no mechanical failure demonstrated.",
            "Uniform interior tones reduce depth clarity and small rim junctions are hard to inspect."
          ],
          "observations": [
            {
              "image": "parent/sources/mauritius/marketing.webp",
              "observation": "Peach-pink grained chest with pastel rolling bands in pink, yellow, sage, blue/lavender and taupe. Brass fittings, dark feet and narrow dark lid band; polished landscape relief."
            },
            {
              "image": "parent/smoke/mauritius/desktop-closed.png",
              "observation": "Pastel flowing lid relief survives over a warmer terracotta shell. All seven bands cannot confidently be counted. Broad dark seam makes lid look slightly ajar; whole chest fits."
            },
            {
              "image": "parent/smoke/mauritius/desktop-open.png",
              "observation": "Warm wavy lid underside and empty matching cavity, dark rim, two rear hinges and projecting tab visible. Rim corners are segmented but not conclusively broken. Full framing retained."
            },
            {
              "image": "parent/smoke/mauritius/mobile-closed.png",
              "observation": "Colored-earth lid remains recognizable, but pastel regions blend and shell material reads ambiguously as clay/copper/resin. Full model and wrapped title fit; buttons do not overlap."
            },
            {
              "image": "parent/smoke/mauritius/mobile-open.png",
              "observation": "Cavity depth is subtle because walls/floor share warm tones; projecting tab is prominent and small hardware simplified. Entire raised lid, feet and controls fit. Exterior ribbons face away, so their count cannot be assessed here."
            }
          ],
          "rationale": "Rolling-earth motif and layout are coherent in both sizes; documented material/count-readability limits warrant disclosure, not automatic functional rejection.",
          "readme_context": "Seven lid-parented rolling mineral ribbons; README explicitly says not all seven can be visually counted at mobile scale, walls may read as clay, and seam/long clasp are deliberate family geometry.",
          "recommendation": "candidate-with-limitations",
          "source_readme": "parent/sources/mauritius/source_readme.md"
        },
        "report": "visual-c.json"

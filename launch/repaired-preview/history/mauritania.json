      "independent_visual": {
        "file": "visual-3.json",
        "findings": {
          "approved": false,
          "artistic_gaps": [
            "Richat reads as a stylized spiral or flower-like crater emblem, not a geographically convincing erosion miniature.",
            "Repeating pale grain and wave bands can look wooden or molded, a material ambiguity also present in the marketing source.",
            "Fine weathering and ridge transitions are simplified; jaggedness alone is not a new defect because the source also has pointed ridges."
          ],
          "final_views": [
            {
              "file": "smoke/mauritania/desktop-closed.png",
              "observations": "Desert-cream chest, flowing tan bands, gray-blue feet and cream/blue ridge ornament preserve major source cues. Ridge silhouette is strongly toothlike and faceted; regular wave texture looks synthetic. Closed seam is conspicuous."
            },
            {
              "file": "smoke/mauritania/desktop-open.png",
              "observations": "Same wave pattern covers lid underside and inner walls. Dark rim, hinge gap and pale corner protrusions are visible; floor partly concealed. Tab, lid and feet fit fully."
            },
            {
              "file": "smoke/mauritania/mobile-closed.png",
              "observations": "Single-line title and entire chest fit. Concentric terrain becomes a small jagged emblem at phone size; hardware silhouette is readable but fine detail is limited."
            },
            {
              "file": "smoke/mauritania/mobile-open.png",
              "observations": "Open state and empty cavity read clearly with no clipping. Uniform wave repetition, blocky feet/hardware and slight edge pixelation are prominent; upper projecting piece remains conspicuous."
            }
          ],
          "follow_up": "Candidate only with abstract-geology and material limitations disclosed. Check seam clearance and hinge/clasp joins independently before approval.",
          "id": "mauritania",
          "recommendation": "candidate-with-limitations",
          "reference": {
            "dimensions": [
              1072,
              976
            ],
            "file": "sources/mauritania/marketing.webp",
            "observations": "Pale cream/blond flowing grain, slate-blue seam and block feet, brass corner caps and central clasp with lower round fitting. Cream and blue-gray irregular concentric ridges form a jagged spiral/eroded-crater ornament."
          }
        }
      },

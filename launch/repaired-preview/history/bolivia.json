      "parent_visual": {
        "context_path": "sources/bolivia/source_readme.md",
        "decision_needed": "Decide whether the subtler runtime salt crust and plank-like body meet the visual promise of the more granular, strongly raised promo treatment.",
        "hardware": "Brass corner caps, long front clasp, round disc and left ring are consistent visible features. Pale irregular stone-like feet remain present. Open views expose rear hinges and released tab; no demonstrated broken hardware.",
        "id": "bolivia",
        "inspected_paths": [
          "sources/bolivia/marketing.webp",
          "smoke/bolivia/desktop-closed.png",
          "smoke/bolivia/desktop-open.png",
          "smoke/bolivia/mobile-closed.png",
          "smoke/bolivia/mobile-open.png"
        ],
        "limitations": [
          "No close-up or alternate light to distinguish shallow physical relief from shading.",
          "Pale interior depth and tiny mounting contacts cannot be established precisely."
        ],
        "mobile_observations": "Ochre peak and blue lid remain recognizable, but salt polygon relief becomes faint. Main clasp is readable; fine fittings merge. Full closed and open silhouettes fit without clipping.",
        "open_observations": "Broad plain white underside and pale cavity are visible with blue-gray rim. Low contrast weakens wall/floor separation; no obvious intrusion or break. Landscape is hidden behind lid, not proven absent.",
        "promotional_finish_vs_geometry": "Raised promotional salt lattice versus fine runtime lines is a relief/readability mismatch, not sufficient evidence that runtime geometry is absent. Readme reports physical loops; stills do not independently verify their depth.",
        "terrain": "Blue inset with pale polygon loops and small ochre relief retains the Uyuni concept. Promo presents more strongly raised, regular lattice-like crust; runtime lines are finer and flatter-looking at default scale. Ochre relief is faceted and mound-like rather than geographically specific.",
        "texture": "White horizontal body courses read as planks or ceramic/masonry more readily than crystalline salt in both treatments, consistent with README. Promo gives feet and crust stronger granular detail; runtime pale surfaces are smoother and lower contrast.",
        "verdict": "needs-decision"

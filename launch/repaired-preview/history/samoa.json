      "independent_visual": {
        "assessment": {
          "concrete_defects": [
            "Pattern borders and motifs end abruptly at panel boundaries in marketing and previews; closed-preview lid decoration is softer and paler than the front panels.",
            "Broad brown closed-lid reveal, coarse frame/panel joins and uneven cap seating are visible; no mesh failure is established. Dark feet and lower rails lose separation against the background, especially on mobile."
          ],
          "framing": "Entire object, raised lid/latch in open views and visible feet remain in frame on desktop and mobile; no obvious UI overlap or asset cropping. Small presentation scale limits detailed hardware assessment.",
          "id": "samoa",
          "inspected_paths": [
            "parent/smoke/samoa/desktop-closed.png",
            "parent/smoke/samoa/desktop-open.png",
            "parent/smoke/samoa/mobile-closed.png",
            "parent/smoke/samoa/mobile-open.png",
            "parent/sources/samoa/marketing.webp"
          ],
          "limitations": [
            "All five original images inspected individually with vision; static endpoint screenshots do not establish motion, hinge/latch operation, clearance, physical buildability, or custody behavior. A released latch in an open view is not itself a defect.",
            "Only the depicted angles and screenshot resolutions were reviewed; hidden faces and fine attachment details remain unverified. Stylized collectible imagery is not a mechanically validated product or authenticated traditional craft. No final approval or art changes.",
            "Ivory terracotta/brown geometric panels, charcoal/slate lava-like frame, brass fittings, dark feet and a small lid-rock cluster correspond to marketing. This is barkcloth-inspired stylization, not authenticated siapo; the repeated bordered panels can read as tiles."
          ],
          "verdict": "candidate-with-limitations"
        },
        "report": "visual-d.json"
      },

      "independent_visual": {
        "assessment": {
          "concrete_defects": [
            "Cloudy stone texture shows rectangular patches and abrupt pattern boundaries, especially on the raised lid underside and inner walls; front texture also looks soft/coarse.",
            "Closed terrain reads as a separate straight-edged slab; lake is a flat colored insert with rough-looking border rather than dimensional water.",
            "Pale stepped lid-corner joins and coarse rounded-foot/hardware silhouettes remain visible, particularly on mobile. Marketing also has a pronounced dark lid seam and discontinuous stone pattern; these are not proven new mesh faults."
          ],
          "id": "tajikistan",
          "inspected_paths": [
            "parent/smoke/tajikistan/desktop-closed.png",
            "parent/smoke/tajikistan/desktop-open.png",
            "parent/smoke/tajikistan/mobile-closed.png",
            "parent/smoke/tajikistan/mobile-open.png",
            "parent/sources/tajikistan/marketing.webp"
          ],
          "limitations": [
            "All five originals inspected individually via vision; paths relative to launch/qa-art-08.",
            "Static endpoints cannot certify hidden contacts, terrain-to-lid attachment, hinges, complete cavity floor, foot seating or motion clearances.",
            "Landscape ornaments turn out of sight in open views; their invisibility there is not proof of missing geometry. No art approval."
          ],
          "observations": [
            "Snow-capped peaks, blue lake, pale mineral body, gold clasp/round fitting/side ring and stone feet remain recognizable against marketing. All model states fit the supplied frames."
          ],
          "verdict": "candidate-with-limitations"
        },

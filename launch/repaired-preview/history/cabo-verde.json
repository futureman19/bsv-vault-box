      "parent_visual": {
        "context_path": "sources/cabo-verde/source_readme.md",
        "decision_needed": "Decide whether default desktop/mobile crater visibility is adequate for the Atlantic Caldera identity or whether presentation/art needs refinement before acceptance.",
        "hardware": "Brass long clasp, front disc, left ring and corner fittings remain recognizable; open captures show rear hinges and released tab. Front disc's function is not visually obvious but it is not evidence of a detached part. No gross hardware break established.",
        "id": "cabo-verde",
        "inspected_paths": [
          "sources/cabo-verde/marketing.webp",
          "smoke/cabo-verde/desktop-closed.png",

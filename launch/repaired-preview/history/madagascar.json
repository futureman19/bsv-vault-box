      "independent_visual": {
        "assessment": {
          "defects": [],
          "id": "madagascar",
          "limitations": [
            "Regular simplified peaks/flutes do not reproduce a dense natural tsingy labyrinth.",
            "Green vegetation is subtle at mobile scale and neighboring ivory peaks lose separation.",
            "Wavy procedural interior/underside shading is prominent; interior depth and floor remain partly hidden.",
            "Closed seam is conspicuous but consistent with the family design."
          ],
          "observations": [
            {
              "image": "parent/sources/madagascar/marketing.webp",
              "observation": "Ivory marbled/ribbed chest with jagged faceted stone peaks, sage green accents, antique brass and dark rounded feet. Strong sculptural limestone silhouette."
            },
            {
              "image": "parent/smoke/madagascar/desktop-closed.png",
              "observation": "Pale pointed forest, ribbed shell, green seam and brass remain coherent. Pinnacles are simplified and crowded at their bases; no obvious missing faces or floating pieces. Entire object fits."
            },
            {
              "image": "parent/smoke/madagascar/desktop-open.png",
              "observation": "Dark gray-green wavy inner walls contrast with pale patterned lid underside and green rim. Two rear brass fittings visible; front wall hides much of floor. No cropping."
            },
            {
              "image": "parent/smoke/madagascar/mobile-closed.png",
              "observation": "Pointed limestone motif remains strong. Neighboring pale peaks merge and sheltered green patches are subtle; lower feet have low contrast. Title, controls and complete silhouette fit."
            },
            {
              "image": "parent/smoke/madagascar/mobile-open.png",
              "observation": "Dark patterned cavity and pale rippled lid underside remain visible with rear hinges/front hardware. Depth and tiny contacts are unclear, but no unequivocal damaged/missing geometry or overlap is shown."
            }
          ],
          "rationale": "Limestone identity is clear on both sizes, full open/closed framing is intact, and no definitive structural or UI visual defect appears.",
          "readme_context": "Procedural limestone pinnacles and sheltered green patches, not geographical reconstruction. Regular peak field/body flutes, shallow vegetation and wavy interior map are disclosed.",
          "recommendation": "candidate-with-limitations",
          "source_readme": "parent/sources/madagascar/source_readme.md"
        },
        "report": "visual-c.json"
      },

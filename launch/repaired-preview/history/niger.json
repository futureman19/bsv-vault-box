          "images": [
            {
              "inspected": true,
              "observations": "Original marketing: pale sand/mineral body reads strongly as wood; shallow dune surface and dark faceted rear outcrop visible. Brass clasp, corner caps, round front disc, side ring and dark stone feet retained; conspicuous dark lid seam.",
              "path": "parent/sources/niger/marketing.webp"

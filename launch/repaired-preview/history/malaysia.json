        "critical_visible_faults": [],
        "file": "visual-b.json",
        "id": "malaysia",
        "observations": {
          "desktop-closed": "Crimson chest with gold lattice, dark inset lid diamonds, brass fittings and rounded feet. Full framing. Gold lines have boundary breaks and uneven aliasing; body reads smooth coating rather than woven textile.",
          "desktop-open": "Crimson lattice continues across lid underside and cavity. Full silhouette fits; dark rear hinge clearance and abrupt rim joins look unfinished.",
          "marketing": "Body visibly mauve/pink with charcoal lid inset rather than model crimson treatment. Same lattice, diamond ornaments and hardware; irregular lines and soft feet remain.",
          "mobile-closed": "Crimson/gold identity legible with no overlap or clipping. Thin lattice jagged; feet chunky and dark.",
          "mobile-open": "Open state and cavity readable; front-left and rear-right rim corners show thin bright edges/protrusions. No definite major mesh failure."
        },
        "parent_status": "needs-decision",
        "parent_status_justified": "yes; independently visible crimson-versus-mauve and dark-top presentation divergence warrants the existing direction hold",
        "recommended_status": "needs-decision"
      }
    },

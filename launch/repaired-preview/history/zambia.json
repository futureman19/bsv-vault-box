      "independent_visual": {
        "assessment": {
          "concrete_defects": [
            "Mobile waterfall, rocky silhouettes and brass details are visibly jagged/blocky; repeated wavy body texture is conspicuous rather than naturally fractured stone.",
            "Open rim corners show protruding/overlapping-looking strips, especially at the right corner, and the raised lid tab lacks clear attachment definition at mobile resolution.",
            "Dark feet merge into base and shadow, obscuring individual silhouettes. Marketing also contains uneven waterfall edging and small stream-platform notches, so rough terrain finishing is not exclusively a viewer regression."
          ],
          "id": "zambia",
          "inspected_paths": [
            "parent/smoke/zambia/desktop-closed.png",
            "parent/smoke/zambia/desktop-open.png",
            "parent/smoke/zambia/mobile-closed.png",
            "parent/smoke/zambia/mobile-open.png",
            "parent/sources/zambia/marketing.webp"
          ],
          "limitations": [
            "All five originals inspected individually via vision; paths relative to launch/qa-art-08.",
            "Static frames cannot certify hidden waterfall/terrain attachment, hinges, cavity floor, foot-to-body/ground contacts or motion clearances.",
            "Dark feet and rear/interior occlusion limit inspection; apparent overlapping rim strips are not proof of intersecting meshes. No art approval."
          ],
          "observations": [
            "Stepped gorge, aqua/white waterfall, sparse green accents, slate body, olive seam and gold hardware retain the source vocabulary. Entire chest and raised lid fit both viewport sizes; no major broken surface observed."
          ],
          "verdict": "candidate-with-limitations"
        },
        "report": "visual-e.json"
      },

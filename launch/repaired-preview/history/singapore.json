      "independent_visual": {
        "assessment": {
          "concrete_defects": [
            "Closed marketing and previews show a substantial dark lid reveal and stepped front-left joins. Open previews show conspicuous pale rim-strip ends and dark corner seams; alignment needs closer inspection, not a claim of breakage.",
            "Mobile fittings are chunky and their attachment points unresolved; celadon panels show broad diagonal/cloudy mottling that may be intended glaze rather than shading error."
          ],
          "framing": "Entire object, raised lid/latch in open views and visible feet remain in frame on desktop and mobile; no obvious UI overlap or asset cropping. Small presentation scale limits detailed hardware assessment.",
          "id": "singapore",
          "inspected_paths": [
            "parent/smoke/singapore/desktop-closed.png",
            "parent/smoke/singapore/desktop-open.png",
            "parent/smoke/singapore/mobile-closed.png",
            "parent/smoke/singapore/mobile-open.png",
            "parent/sources/singapore/marketing.webp"
          ],
          "limitations": [
            "All five original images inspected individually with vision; static endpoint screenshots do not establish motion, hinge/latch operation, clearance, physical buildability, or custody behavior. A released latch in an open view is not itself a defect.",
            "Only the depicted angles and screenshot resolutions were reviewed; hidden faces and fine attachment details remain unverified. Stylized collectible imagery is not a mechanically validated product or authenticated traditional craft. No final approval or art changes.",
            "Inherited user-review hold retained without reinterpretation or clearance. Celadon body, three raised orchid-like ornaments, brass border/fittings and teal rounded feet correspond across marketing and closed views. Flowers read as applied sculptural decoration rather than flat enamel; material treatment remains stylized and requires user judgment. Outer-lid flowers being hidden in open views is not a missing-art defect."
          ],
          "verdict": "needs-user-review"
        },
        "report": "visual-d.json"
      },
